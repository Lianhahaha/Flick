-  (isClaude ? parseClaude : parseCodex)(obj, emit, st);
+  if (kind === 'claude') parseClaude(obj, emit, st);
+  else if (kind === 'codex') parseCodex(obj, emit, st);
+  else parseOpencode(obj, emit, st);
