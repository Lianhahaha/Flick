+function opencodeArgs(sessionId?: string | null) {
+  // `opencode run` reads the prompt from stdin when no message argument is given, so the prompt never hits a command line.
+  // --auto auto-approves tool calls (the app's own gates still decide what is accepted); --format json is the event stream.
+  const a = ['run', '--format', 'json', '--auto', '--model', opencodeModel(), '--agent', opencodeAgent()];
+  if (sessionId) a.push('--session', sessionId);
+  return a;
+}
+export function parseOpencode(obj: Json, emit: Emit, st: TurnState) {
+  const id = obj.sessionID || obj.session_id;
+  if (id && id !== st.sessionId) { st.sessionId = id; emit({ type: 'session', id }); }
+  const p = obj.part || {};
+  if (obj.type === 'text' && p.text) { st.text = p.text; emit({ type: 'text', text: p.text }); }
+  if (obj.type === 'reasoning' && (p.text || '').trim()) emit({ type: 'thinking', text: short(p.text, 1200) });
+  if (obj.type === 'tool_use') {
+    const input = p.state?.input || {};
+    emit({ type: 'tool', name: p.tool || 'tool', detail: short(input.command || input.path || input.filePath || input.pattern || input) });
+  }
+  if (obj.type === 'step_finish') {
+    const reason = p.reason;
+    st.ok = reason !== 'error' && reason !== 'length';
+    if (typeof p.cost === 'number') st.cost = p.cost;
+    if (!st.ok) emit({ type: 'error', text: `OpenCode step ended: ${reason || 'unknown'}` });
+  }
+  if (obj.type === 'error') { st.ok = false; emit({ type: 'error', text: short(obj.error?.message || obj.message || obj, 400) }); }
+}
