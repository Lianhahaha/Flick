+test('OpenCode stream', () => {
+  const { events, st } = run(parseOpencode, [
+    { type: 'step_start', sessionID: 'o1' },
+    { type: 'tool_use', sessionID: 'o1', part: { tool: 'write', state: { input: { path: 'hello.txt' } } } },
