@@ -0,0 +1,117 @@
+// Custom OpenAI-compatible API profile for the OpenCode director.
+//
+// The key lives in ~/.reelmimic/secrets.json (outside the repo); the non-secret
+// provider settings are written to .opencode/opencode.json so OpenCode can load
+// them when it runs from the repo root. The key itself is only passed through
+// the child process environment.
+import { existsSync, mkdirSync, readFileSync, renameSync, rmSync, writeFileSync } from 'node:fs';
+import { dirname, join } from 'node:path';
+import { SECRETS_PATH } from './env.ts';
+import type { CustomApiStatus } from '../shared/types.ts';
+
+const ROOT = join(import.meta.dirname, '..', '..');
+const CONFIG_DIR = join(ROOT, '.opencode');
+const CONFIG_FILE = join(CONFIG_DIR, 'opencode.json');
+const MARKER_FILE = join(CONFIG_DIR, '.reelmimic-custom');
+const KEYS = ['REELMIMIC_CUSTOM_API_KEY', 'REELMIMIC_CUSTOM_BASE_URL', 'REELMIMIC_CUSTOM_MODEL'] as const;
+
+type Secrets = Record<string, unknown>;
+const readSecrets = (): Secrets => {
+  if (!existsSync(SECRETS_PATH)) return {};
+  return JSON.parse(readFileSync(SECRETS_PATH, 'utf8')) as Secrets;
+};
+const writeSecrets = (s: Secrets) => {
+  mkdirSync(dirname(SECRETS_PATH), { recursive: true });
+  const tmp = `${SECRETS_PATH}.${process.pid}.tmp`;
+  writeFileSync(tmp, JSON.stringify(s, null, 2));
+  renameSync(tmp, SECRETS_PATH);
+};
+
+const configured = () => !!(process.env.REELMIMIC_CUSTOM_API_KEY && process.env.REELMIMIC_CUSTOM_BASE_URL && process.env.REELMIMIC_CUSTOM_MODEL);
+
+export function customApiStatus(): CustomApiStatus {
+  return {
+    configured: configured(),
+    baseUrl: process.env.REELMIMIC_CUSTOM_BASE_URL || '',
+    model: process.env.REELMIMIC_CUSTOM_MODEL || '',
+    keySet: !!process.env.REELMIMIC_CUSTOM_API_KEY,
+  };
+}
+
+function syncConfig() {
+  if (!configured()) {
+    if (existsSync(MARKER_FILE)) {
+      rmSync(CONFIG_FILE, { force: true });
+      rmSync(MARKER_FILE, { force: true });
+    }
+    return;
+  }
+  if (existsSync(CONFIG_FILE) && !existsSync(MARKER_FILE)) {
+    throw new Error('An existing .opencode/opencode.json was found. Merge the ReelMimic provider manually, then retry.');
+  }
+  mkdirSync(CONFIG_DIR, { recursive: true });
+  writeFileSync(MARKER_FILE, 'managed by ReelMimic custom API\n');
+  const config = {
+    $schema: 'https://opencode.ai/config.json',
+    providers: {
+      reelmimic: {
+        name: 'ReelMimic Custom API',
+        env: ['REELMIMIC_CUSTOM_API_KEY'],
+        package: '@opencode/ai/providers/openai-compatible',
+        settings: { baseURL: process.env.REELMIMIC_CUSTOM_BASE_URL },
+        models: {
+          custom: {
+            modelID: process.env.REELMIMIC_CUSTOM_MODEL,
+            name: process.env.REELMIMIC_CUSTOM_MODEL,
+            capabilities: { tools: true },
+          },
+        },
+      },
+    },
+  };
+  const tmp = `${CONFIG_FILE}.${process.pid}.tmp`;
+  writeFileSync(tmp, JSON.stringify(config, null, 2));
+  renameSync(tmp, CONFIG_FILE);
+}
+
+export function syncCustomConfig() {
+  try { syncConfig(); } catch (e) { console.error('custom API config:', (e as Error).message); }
+}
+
+export function saveCustomApi(input: { apiKey?: string; baseUrl?: string; model?: string }): CustomApiStatus {
+  if (existsSync(CONFIG_FILE) && !existsSync(MARKER_FILE)) {
+    throw new Error('An existing .opencode/opencode.json was found. Merge the ReelMimic provider manually, then retry.');
+  }
+  const apiKey = (input.apiKey || '').trim();
+  const baseUrl = (input.baseUrl || '').trim().replace(/\/+$/, '');
+  const model = (input.model || '').trim();
+  if (!/^https?:\/\/\S+$/i.test(baseUrl)) throw new Error('Base URL must start with http:// or https://');
+  if (!model) throw new Error('Model ID is required');
+  if (model.length > 200) throw new Error('Model ID is too long');
+
+  const secrets = readSecrets();
+  if (apiKey) secrets.REELMIMIC_CUSTOM_API_KEY = apiKey;
+  if (!secrets.REELMIMIC_CUSTOM_API_KEY && !process.env.REELMIMIC_CUSTOM_API_KEY) throw new Error('API key is required');
+  secrets.REELMIMIC_CUSTOM_BASE_URL = baseUrl;
+  secrets.REELMIMIC_CUSTOM_MODEL = model;
+  writeSecrets(secrets);
+
+  for (const k of KEYS) {
+    const v = secrets[k];
+    if (v != null) process.env[k] = String(v);
+  }
+  syncConfig();
+  return customApiStatus();
+}
+
+export function clearCustomApi(): CustomApiStatus {
+  const secrets = readSecrets();
+  for (const k of KEYS) delete secrets[k];
+  writeSecrets(secrets);
+  for (const k of KEYS) delete process.env[k];
+  if (existsSync(MARKER_FILE)) {
+    rmSync(CONFIG_FILE, { force: true });
+    rmSync(MARKER_FILE, { force: true });
+  }
+  return customApiStatus();
+}
